rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getStaffDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
             get(/databases/$(database)/documents/users/$(request.auth.uid)) :
             get(/databases/$(database)/documents/staff_roles/$(request.auth.uid));
    }

    function isStaff() {
      return isAuthenticated() && 
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) || 
              exists(/databases/$(database)/documents/staff_roles/$(request.auth.uid))) &&
             getStaffDoc().data.active == true;
    }

    function getStaffRole() {
      return getStaffDoc().data.role;
    }

    function isSuperAdmin() {
      return isStaff() && getStaffRole() == 'super_admin';
    }

    function isClinicOwner() {
      return isStaff() && (getStaffRole() == 'clinic_owner' || getStaffRole() == 'super_admin');
    }

    function isVeterinarian() {
      return isStaff() && (getStaffRole() == 'veterinarian' || getStaffRole() == 'super_admin');
    }

    function isReceptionist() {
      return isStaff() && (getStaffRole() == 'receptionist' || isClinicOwner());
    }

    // Ownership hierarchy functions
    function isPetOwnerOfClient(clientId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/clients/$(clientId)) &&
             get(/databases/$(database)/documents/clients/$(clientId)).data.ownerAuthId == request.auth.uid;
    }

    function isPetOwnerOfPet(petId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/pets/$(petId)) &&
             (
               (resource.data.ownerAuthId != null && resource.data.ownerAuthId == request.auth.uid) ||
               (resource.data.clientId != null && isPetOwnerOfClient(resource.data.clientId))
             );
    }

    // 1. Users and Staff Roles Collections: LEAST PRIVILEGE
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isClinicOwner());
      allow create: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow update: if isSuperAdmin() || 
                    (isAuthenticated() && request.auth.uid == userId && 
                     (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])));
      allow delete: if isSuperAdmin();
    }

    match /staff_roles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isClinicOwner());
      allow write: if isSuperAdmin();
    }

    // 2. Staff Invitations: Managed solely by Super Admin
    match /staff_invitations/{invitationId} {
      allow read: if isAuthenticated() && (resource.data.email == request.auth.token.email || isClinicOwner());
      allow create, update, delete: if isSuperAdmin();
    }

    // 3. Clients
    match /clients/{clientId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.ownerAuthId == request.auth.uid);
      allow create: if isStaff() || (isAuthenticated() && request.resource.data.ownerAuthId == request.auth.uid);
      allow update: if isStaff() || 
                    (isAuthenticated() && resource.data.ownerAuthId == request.auth.uid && 
                     request.resource.data.ownerAuthId == resource.data.ownerAuthId);
      allow delete: if isSuperAdmin();
    }

    // 4. Pets
    match /pets/{petId} {
      allow read: if isStaff() || isPetOwnerOfClient(resource.data.clientId);
      allow create: if isStaff() || isPetOwnerOfClient(request.resource.data.clientId);
      allow update: if isStaff() || (isPetOwnerOfClient(resource.data.clientId) && 
                                     request.resource.data.clientId == resource.data.clientId);
      allow delete: if isSuperAdmin() || isClinicOwner();
    }

    // 5. Appointments
    match /appointments/{appointmentId} {
      allow read: if isStaff() || isPetOwnerOfClient(resource.data.clientId);
      allow create: if isStaff() || isPetOwnerOfClient(request.resource.data.clientId);
      allow update: if isStaff() || (isPetOwnerOfClient(resource.data.clientId) &&
                                     request.resource.data.clientId == resource.data.clientId);
      allow delete: if isSuperAdmin() || isReceptionist();
    }

    // 6. Consultations: IMMUTABLE FINALIZATION (Draft -> Finalized)
    // - Draft notes can be edited by Veterinarians.
    // - Once finalized (isFinalized == true), CANNOT be edited or deleted by ANY role (including Super Admin).
    // - Post-finalization changes MUST use the addenda subcollection.
    match /consultations/{consultId} {
      allow read: if isStaff() || (isPetOwnerOfPet(resource.data.petId) && resource.data.isOwnerVisible == true);
      allow create: if isVeterinarian();
      allow update: if isVeterinarian() && 
                    resource.data.isFinalized == false && 
                    (request.resource.data.isFinalized == true || request.resource.data.isFinalized == false);
      allow delete: if isSuperAdmin() && resource.data.isFinalized == false;

      // Addenda subcollection: append-only notes attached to a finalized consultation
      match /addenda/{addendumId} {
        allow read: if isStaff() || (isPetOwnerOfPet(get(/databases/$(database)/documents/consultations/$(consultId)).data.petId) && resource.data.isOwnerVisible == true);
        allow create: if isVeterinarian();
        allow update, delete: if false; // Append-only audit trail
      }
    }

    // 7. Preventive Medicine & Clinical Records
    match /vaccinations/{vaccineId} {
      allow read: if isStaff() || isPetOwnerOfPet(resource.data.petId);
      allow create, update: if isVeterinarian();
      allow delete: if isSuperAdmin();
    }

    match /deworming_records/{dewormId} {
      allow read: if isStaff() || isPetOwnerOfPet(resource.data.petId);
      allow create, update: if isVeterinarian();
      allow delete: if isSuperAdmin();
    }

    match /deworming/{dewormId} {
      allow read: if isStaff() || isPetOwnerOfPet(resource.data.petId);
      allow create, update: if isVeterinarian();
      allow delete: if isSuperAdmin();
    }

    match /parasite_records/{parasiteId} {
      allow read: if isStaff() || isPetOwnerOfPet(resource.data.petId);
      allow create, update: if isVeterinarian();
      allow delete: if isSuperAdmin();
    }

    match /prescriptions/{rxId} {
      allow read: if isStaff() || isPetOwnerOfPet(resource.data.petId);
      allow create, update: if isVeterinarian();
      allow delete: if isSuperAdmin();
    }

    match /weight_records/{weightId} {
      allow read: if isStaff() || isPetOwnerOfPet(resource.data.petId);
      allow create, update: if isStaff() || isPetOwnerOfPet(request.resource.data.petId);
      allow delete: if isSuperAdmin();
    }

    // 8. Inventory (Stock levels and pharmacy items)
    // quantityOnHand must always be >= 0
    match /inventory_items/{skuId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.quantityOnHand >= 0;
      allow update: if isStaff() && request.resource.data.quantityOnHand >= 0;
      allow delete: if isSuperAdmin() || isClinicOwner();

      // Audit trail of inventory movements
      match /movements/{movementId} {
        allow read: if isStaff();
        allow create: if isStaff();
        allow update, delete: if false;
      }
    }

    match /inventory/{itemId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin() || isClinicOwner();
    }

    // 9. Invoices & Billing
    match /invoices/{invoiceId} {
      allow read: if isStaff() || isPetOwnerOfClient(resource.data.clientId);
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // 10. Payments: STRICT APPEND-ONLY FINANCIAL INTEGRITY
    // Existing payments CANNOT be edited or deleted by ANY client or role, preserving accounting history.
    match /payments/{paymentId} {
      allow read: if isStaff() || isPetOwnerOfClient(resource.data.clientId);
      allow create: if isStaff() && request.resource.data.amount > 0;
      allow update, delete: if false;
    }

    // 11. CRM Inquiries
    match /enquiries/{enquiryId} {
      allow read: if isStaff();
      allow create: if true; // Public submission from contact / adoption forms
      allow update: if isStaff();
      allow delete: if isSuperAdmin() || isClinicOwner();
    }

    // 12. Clinic Profile & Dynamic Settings
    match /clinic_settings/{profileId} {
      allow read: if true; // Public for dynamic contact numbers, branding, and hours
      allow write: if isClinicOwner();
    }

    match /settings/{profileId} {
      allow read: if true;
      allow write: if isClinicOwner();
    }

    // 13. System Audit Logs: Append-only
    match /audit_logs/{logId} {
      allow read: if isClinicOwner();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
